rules_version = '2';

// Emulator-only for now (a real Firebase project is a separate future step —
// see CLAUDE.md "Known gaps"). Admin model: signed-in AND carrying the
// `admin` custom claim, set via scripts/seed-admin-user.mjs's
// auth.setCustomUserClaims() (Console/Admin SDK in a real deployment).
// Being signed in alone is not enough — a Firebase Web API key is public by
// design (it ships in the JS bundle), so this app having no sign-up *page*
// doesn't stop someone from calling createUserWithEmailAndPassword()
// directly against a real project. A custom claim, unlike a Firestore
// allowlist doc, is also readable by the client itself (via
// getIdTokenResult()) — see AuthService.isAdmin — so the app can show
// correct admin-only UI, not just correctly reject the underlying writes.
//
// MULTI-CLUB GROUNDWORK: almost everything below now lives nested under
// /clubs/{clubId} — a club's meetings, roles, roster, saved/published
// agendas, member history, check-in contacts, its own granted-admin list,
// and its own audit log are all isolated per club by path alone (see
// core/club/club-context.service.ts). isAdmin() (the real, global custom
// claim) is unchanged and deliberately NOT club-scoped — it's a
// platform-operator tier spanning every club (custom claims share one
// ~1000-byte token budget, which doesn't scale to a per-club claims list).
// isAppAdmin(clubId) is the club-scoped equivalent of the old bare
// isAppAdmin() — true for the real claim OR a
// clubs/{clubId}/appAdmins/{uid} grant for THAT specific club.
//
// `members/{uid}` stays global, top-level, unchanged — a self-service
// account is one Firebase login, independent of any club (see
// AuthService's class doc).
//
// The OLD flat top-level collections (checkins, roleDefinitions,
// committeeRoster, publishedAgendas, savedAgendas, memberHistory,
// checkinContacts, appAdmins, auditLog) still have rules below, left in
// place deliberately, dead but harmless during the migration window — see
// scripts/migrate-to-clubs.mjs's own header comment and CLAUDE.md's
// documented Phase 0 precedent (the old committeeRoleDefinitions
// collection was handled the same way: never deleted immediately, cleaned
// up in a later, separate deploy once the new shape is confirmed working).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // A club's own branding/identity doc — see core/models/club.models.ts.
    // Public read: /checkin and /preview are anonymous and need a club's
    // name/logo/address to render their header before any auth state is
    // known. Create is platform-admin-only (the real global `admin` claim -
    // see core/club/club-provisioning.service.ts and the /platform/clubs/new
    // screen); scripts/create-club.mjs (Admin SDK) is the other path. A
    // platform admin may also EDIT a club (branding, name, active) but never
    // change its slug or createdAt; no client can delete a club.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.slug.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active == true;
      // Platform admin: anything except slug/createdAt. A club's own admin
      // (real claim or granted): only the branding fields below, never
      // `active`/`slug`/`createdAt`, and logos (stored inline as data URLs)
      // are capped so the club document stays well under Firestore's 1MB limit.
      allow update: if (isAdmin()
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.active is bool)
        || (isAppAdmin(clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['name', 'subLine', 'addressLine', 'missionStatement', 'website', 'facebookPage', 'logoLeft', 'logoRight'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.logoLeft is string
        && request.resource.data.logoLeft.size() < 700000
        && request.resource.data.logoRight is string
        && request.resource.data.logoRight.size() < 700000);
      allow delete: if false;

      // Granted admin power for THIS club — a Firestore document, not a
      // custom claim, so it can be assigned by any of this club's admins
      // from inside the app itself. Own-uid read lets a granted admin's
      // own client determine its own status without browsing the whole
      // list; isAppAdmin(clubId) read is for this club's manage-admins
      // screen. The one thing still off-limits to everyone, real claim
      // included, is granting/regranting YOUR OWN uid for this club —
      // pointless (isAdmin() already implies isAppAdmin(clubId)) and a
      // real footgun for a true admin specifically: it would make their
      // access to this club outlive their own claim, so revoking that
      // claim later would silently fail to remove it here. delete has no
      // such restriction.
      function isGrantedAdmin(cid) {
        return request.auth != null &&
          exists(/databases/$(database)/documents/clubs/$(cid)/appAdmins/$(request.auth.uid));
      }
      function isAppAdmin(cid) {
        return isAdmin() || isGrantedAdmin(cid);
      }

      match /appAdmins/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAppAdmin(clubId));
        allow create, update: if isAppAdmin(clubId) && request.auth.uid != uid;
        allow delete: if isAppAdmin(clubId);
      }

      // Check-in board: fully public, anonymous, first-come-first-served —
      // unchanged from the old top-level rule, just nested. Unrelated to
      // auth by design — do not gate this.
      match /checkins/{meetingId} {
        allow read, write: if true;
      }

      // Append-only trail of meaningful admin actions FOR THIS CLUB — see
      // core/audit/audit-log.util.ts's appendAuditEntry(). Any app-admin OF
      // THIS CLUB can create an entry, but read stays isAdmin()-only — the
      // real, GLOBAL claim, deliberately not club-scoped: who did what
      // should only be visible to a true platform-operator claim-holder,
      // not to every app-admin the log might itself be about. A true admin
      // reaches any specific club's log by visiting that club's own
      // /c/<slug>/admin/audit-log — there is no cross-club log view in this
      // pass. No update or delete via the client, ever, by anyone.
      match /auditLog/{entryId} {
        allow read: if isAdmin();
        allow create: if isAppAdmin(clubId)
          && request.resource.data.action is string
          && request.resource.data.actorUid is string
          && request.resource.data.at is string
          && request.resource.data.summary is string;
        allow update, delete: if false;
      }

      // Both meeting roles (claimed via check-in) and committee/governance
      // titles (admin-assigned only) — discriminated by the doc's own
      // `kind` field, not by collection. Public read (check-in role board +
      // /preview both need these unauthenticated); only this club's admin
      // UI writes.
      match /roleDefinitions/{roleId} {
        allow read: if true;
        allow write: if isAppAdmin(clubId);
      }
      match /committeeRoster/{docId} {
        allow read: if true;
        allow write: if isAppAdmin(clubId);
      }
      match /publishedAgendas/{meetingId} {
        allow read: if true;
        allow write: if isAppAdmin(clubId);
      }

      // The one stored copy of each meeting's header fields (date/theme/
      // word/start/club/sub/addr), shared by the agenda editor and the
      // check-in page. Public read — /checkin is anonymous and already shows
      // all of this — but only ever written by this club's app-admin, inside
      // the same batch as savedAgendas/publishedAgendas (see MeetingDoc in
      // core/models/meeting-doc.models.ts). Must be deployed BEFORE the
      // bundle that writes it: a missing rule would fail those whole batches.
      match /meetings/{meetingId} {
        allow read: if true;
        allow write: if isAppAdmin(clubId);
      }

      // This club's admin's private drafts — nobody else ever reads or writes these.
      match /savedAgendas/{meetingId} {
        allow read, write: if isAppAdmin(clubId);
      }

      // Official confirmed history for this club — written only by an
      // admin's "mark register" actions on /checkin (see
      // AttendanceConfirmationService), one doc per (meeting, member) at
      // memberHistory/{meetingId}_{uid}. Unlike checkins/** (unverified
      // self-report, public), this collection IS the source of truth the
      // member dashboard reads — so only this club's admin may write it.
      match /memberHistory/{recordId} {
        allow read: if request.auth != null && (isAppAdmin(clubId) || request.auth.uid == resource.data.uid);
        allow write: if isAppAdmin(clubId);
      }

      // Club membership with admin approval — see MembershipService. A
      // member creates their OWN row as `pending` (and may ask again after a
      // rejection/removal, or withdraw a pending request); only a club admin
      // can approve, reject or remove, and never for their own uid.
      match /memberships/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAppAdmin(clubId));
        allow create: if request.auth != null && (
          (request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.decidedAt == null)
          ||
          // A platform admin (the real claim) can add anyone to any club directly, already active.
          (isAdmin()
            && request.resource.data.uid == uid
            && request.resource.data.status == 'active'
            && request.resource.data.email is string
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0));
        allow update: if request.auth != null && (
          (request.auth.uid == uid
            && resource.data.status in ['rejected', 'removed']
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.decidedAt == null)
          ||
          (isAppAdmin(clubId)
            && request.auth.uid != uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.status in ['active', 'rejected', 'removed']));
        allow delete: if request.auth != null && request.auth.uid == uid && resource.data.status == 'pending';
      }

      // Real emails behind this club's check-in identities — foundation
      // for a planned reminder-email feature. Write is open, same as
      // checkins/** itself (anonymous, self-reported, no verification
      // barrier), but read is admin-only.
      match /checkinContacts/{uid} {
        allow read: if isAppAdmin(clubId);
        allow write: if true;
      }
    }

    // Lets a signed-in person list THEIR OWN memberships across every club (a
    // collection-group query, used by the club picker and My Clubs). The
    // per-club rule above covers reads inside a club; this recursive rule is
    // what a collection-group query needs, and it only ever exposes rows whose
    // uid is the caller's — except a platform admin (the real claim), who can
    // read every row (the All Members page).
    match /{path=**}/memberships/{uid} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // The only way a URL segment (/c/<slug>/...) resolves to a clubId —
    // see ClubContextService.setClub(). Public read (needed pre-auth, same
    // reasoning as clubs/{clubId} above). Create-only, platform-admin-only,
    // and only when the pointer agrees with a club doc written in the SAME
    // batch (getAfter) whose slug is this document's id - so a taken slug
    // can never be overwritten and a pointer can't name someone else's
    // club. scripts/migrate-to-clubs.mjs / create-club.mjs (Admin SDK) also
    // create these.
    match /clubSlugs/{slug} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.clubId is string
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.slug == slug;
      allow update, delete: if false;
    }

    // Self-service member accounts — GLOBAL, not club-scoped (see
    // AuthService's class doc: one Firebase login is independent of any
    // club). Own-uid read/write, plus admin read for a future member
    // directory — but never admin write, which would defeat the point of
    // self-service. No delete in v1: no product decision yet on what
    // happens to a deleted member's history in any club's `checkins/**`.
    match /members/{memberId} {
      allow read: if request.auth != null && (request.auth.uid == memberId || isAdmin());
      // displayName is never allowed to end up "", null, or missing — the
      // ultimate guarantee against a direct API write bypassing
      // MemberProfileService's own requireDisplayName() check. size() > 0
      // rejects "" too, not just a missing/wrong-typed field.
      allow create, update: if request.auth != null && request.auth.uid == memberId
        && request.resource.data.uid == memberId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;
      allow delete: if false;
    }

    // ── Everything below is the OLD, pre-multi-club, flat shape — left in
    // place deliberately (dead but harmless) during the migration window.
    // Nothing in the app reads or writes these once the club-scoped bundle
    // is deployed; removed only in a later, separate cleanup pass. See this
    // file's own header comment and scripts/migrate-to-clubs.mjs.
    function isGrantedAdminLegacy() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/appAdmins/$(request.auth.uid));
    }
    function isAppAdminLegacy() {
      return isAdmin() || isGrantedAdminLegacy();
    }
    match /checkins/{meetingId} {
      allow read, write: if true;
    }
    match /appAdmins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAppAdminLegacy());
      allow create, update: if isAppAdminLegacy() && request.auth.uid != uid;
      allow delete: if isAppAdminLegacy();
    }
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAppAdminLegacy()
        && request.resource.data.action is string
        && request.resource.data.actorUid is string
        && request.resource.data.at is string
        && request.resource.data.summary is string;
      allow update, delete: if false;
    }
    match /roleDefinitions/{roleId} {
      allow read: if true;
      allow write: if isAppAdminLegacy();
    }
    match /committeeRoster/{docId} {
      allow read: if true;
      allow write: if isAppAdminLegacy();
    }
    match /publishedAgendas/{meetingId} {
      allow read: if true;
      allow write: if isAppAdminLegacy();
    }
    match /savedAgendas/{meetingId} {
      allow read, write: if isAppAdminLegacy();
    }
    match /memberHistory/{recordId} {
      allow read: if request.auth != null && (isAppAdminLegacy() || request.auth.uid == resource.data.uid);
      allow write: if isAppAdminLegacy();
    }
    match /checkinContacts/{uid} {
      allow read: if isAppAdminLegacy();
      allow write: if true;
    }
  }
}
